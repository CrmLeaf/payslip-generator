{
    "name": "crmleaf/payslip-generator",
    "description": "Compliance-ready payslip PDFs with your company branding.",
    "keywords": ["payslip", "pdf", "payroll", "india", "laravel", "salary-slip"],
    "homepage": "https://www.indpayroll.com/free-tools/payslip-generator",
    "license": "MIT",
    "type": "library",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/crmleaf/payroll-core"
        }
    ],
    "authors": [
        {
            "name": "CRMLeaf",
            "email": "opensource@crmleaf.app",
            "homepage": "https://www.crmleaf.app"
        }
    ],
    "support": {
        "issues": "https://github.com/crmleaf/payslip-generator/issues",
        "source": "https://github.com/crmleaf/payslip-generator"
    },
    "require": {
        "php": "^8.2",
        "crmleaf/payroll-core": "^1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.58",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "phpstan/phpstan": "^1.11 || ^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "crmleaf/laravel-payroll": "Installs the whole CRMLeaf payroll suite behind one config file, one Blade namespace and one optional JSON API.",
        "dompdf/dompdf": "Required to render the pdf document; any PSR-compatible renderer can be bound in its place.",
        "illuminate/support": "Only needed for the Laravel service provider, routes and Blade component. The calculator itself is framework-agnostic."
    },
    "autoload": {
        "psr-4": {
            "Crmleaf\\Payroll\\Tools\\PayslipGenerator\\": "src/",
            "Crmleaf\\Payroll\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Crmleaf\\Payroll\\Tools\\PayslipGenerator\\Tests\\": "tests/",
            "Crmleaf\\Payroll\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Crmleaf\\Payroll\\Tools\\PayslipGenerator\\PayslipGeneratorServiceProvider"
            ]
        },
        "crmleaf": {
            "tool": "payslip-generator",
            "category": "document-generators",
            "backend": "required",
            "calculator": "Crmleaf\\Payroll\\Calculators\\PayslipGenerator",
            "generated-from": "stubs/tool/composer.json.stub via bin/generate-tools.php"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "lint:fix": "php-cs-fixer fix",
        "analyse": "phpstan analyse",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
